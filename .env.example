# Phase 5 laptop/client settings. Set these in PowerShell or a local .env loader.
# This project uses os.environ; .env is NOT automatically loaded.
VLM_BASE_URL=http://127.0.0.1:8010/v1
VLM_MODEL=invoice-extractor
VLM_API_KEY=SET_A_LONG_RANDOM_SECRET_AT_RUNTIME
VLM_TIMEOUT_SECONDS=180

# The GPU server uses VLLM_API_KEY with the same secret.
# Do not commit real keys or expose the vLLM port publicly.
